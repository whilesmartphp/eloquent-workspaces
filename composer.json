{
  "name": "whilesmart/eloquent-workspaces",
  "description": "Workspace management package for Laravel applications",
  "type": "library",
  "license": "MIT",
  "package-version": "1.0.1",
  "authors": [
    {
      "name": "WhileSmart",
      "email": "engineering@whilesmart.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "whilesmart/eloquent-roles": "*",
    "cviebrock/eloquent-sluggable": "^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.4",
    "zircote/swagger-php": "^5.1",
    "nunomaduro/collision": "^8.8",
    "laravel/pint": "^1.22",
    "fakerphp/faker": "^1.24"
  },
  "suggest": {
    "whilesmart/organizations": "For organization/customer management within workspaces",
    "whilesmart/projects": "For project management within workspaces"
  },
  "autoload": {
    "psr-4": {
      "Whilesmart\\Workspaces\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Whilesmart\\Workspaces\\WorkspacesServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/testbench package:test",
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "pint": [
      "./vendor/bin/pint"
    ],
    "pint:test": [
      "./vendor/bin/pint --test"
    ]
  }
}

